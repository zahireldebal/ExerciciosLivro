# Algoritmo 44
# Ler um número e uma base e imprimir o logaritmo do número nessa base.

prog alg44
  real n, base, resultado;
  imprima "\nDigite o logaritmando: ";
  leia n;
  imprima "\nDigite a base: ";
  leia base;
  resultado <- log(n) / log(base);
  imprima "\nLogaritmo de ", n, " na base ", base, " = ", resultado;
  imprima "\n";
fimprog
