# Algoritmo 48
# 100 kW custam 1/7 do salário mínimo.
# Imprimir: valor de cada kW, valor a pagar e valor com 10% de desconto.

prog alg48
  real salMin, kwGasto, valorKw, valorPagar, valorDesconto;
  imprima "\nSalario minimo: ";
  leia salMin;
  imprima "\nQuantidade de kW gasta: ";
  leia kwGasto;
  # 100 kW = salMin / 7  ->  1 kW = salMin / 700
  valorKw <- salMin / 700;
  valorPagar <- valorKw * kwGasto;
  valorDesconto <- valorPagar - valorPagar * 0.10;
  imprima "\nValor de cada kW: ", valorKw;
  imprima "\nValor a pagar: ", valorPagar;
  imprima "\nValor com desconto de 10%: ", valorDesconto;
  imprima "\n";
fimprog
