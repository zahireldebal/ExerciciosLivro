# Algoritmo 58
# Ler xnum1, xnum2 e xnum3 e imprimir x, sendo:
#   x = xnum1 + xnum2/(xnum3 + xnum1) + 2*(xnum1 - xnum2) + log2(64)
# log2(64) = log(64) / log(2)  (mudança de base)

prog alg58
  real xnum1, xnum2, xnum3, x;
  imprima "\nxnum1: ";
  leia xnum1;
  imprima "\nxnum2: ";
  leia xnum2;
  imprima "\nxnum3: ";
  leia xnum3;
  x <- xnum1 + xnum2 / (xnum3 + xnum1) + 2 * (xnum1 - xnum2) + log(64) / log(2);
  imprima "\nx = ", x;
  imprima "\n";
fimprog
