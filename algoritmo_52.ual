# Algoritmo 52
# Ler o lado de um quadrado e imprimir perímetro, área e diagonal.

prog alg52
  real lado, perimetro, area, diagonal;
  imprima "\nLado: ";
  leia lado;
  perimetro <- 4 * lado;
  area <- lado ** 2;
  diagonal <- lado * raiz(2);
  imprima "\nperimetro: ", perimetro;
  imprima "\narea: ", area;
  imprima "\ndiagonal: ", diagonal;
  imprima "\n";
fimprog
