# Algoritmo 42
# Ler um ângulo em graus e imprimir seno, cosseno, tangente,
# secante, cossecante e cotangente.

prog alg42
  real graus, rad;
  imprima "\nDigite o angulo em graus: ";
  leia graus;
  rad <- graus * pi / 180;
  imprima "\nseno: ", sen(rad);
  imprima "\ncosseno: ", cos(rad);
  imprima "\ntangente: ", tan(rad);
  imprima "\nsecante: ", 1 / cos(rad);
  imprima "\ncossecante: ", 1 / sen(rad);
  imprima "\ncotangente: ", 1 / tan(rad);
  imprima "\n";
fimprog
