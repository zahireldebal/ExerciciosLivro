# Algoritmo 60
# Ler a razão de uma PA e o 1º termo. Imprimir o 10º termo.
# an = a1 + (n - 1) * r   ->   a10 = a1 + 9 * r

prog alg60
  real a1, razao, a10;
  imprima "\nPrimeiro termo: ";
  leia a1;
  imprima "\nRazao da PA: ";
  leia razao;
  a10 <- a1 + 9 * razao;
  imprima "\nO 10o termo da PA e: ", a10;
  imprima "\n";
fimprog
