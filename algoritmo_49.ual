# Algoritmo 49
# Ler um nome e imprimir: nome todo, primeiro caractere, último caractere,
# do primeiro ao terceiro, quarto caractere, todos menos o primeiro
# e os dois últimos.
# Funções de string do livro: strprim, strult, strnprim, strelem,
# strresto, strnresto, strtam (os índices de strelem começam em 0).

prog alg49
  string nome;
  int tamanho, corte;
  imprima "\nDigite um nome: ";
  leia nome;
  tamanho <- strtam(nome);
  corte <- tamanho - 2;
  imprima "\ntodo o nome: ", nome;
  imprima "\nprimeiro caractere: ", strprim(nome);
  imprima "\nultimo caractere: ", strult(nome);
  imprima "\ndo primeiro ao terceiro: ", strnprim(nome, 3);
  imprima "\nquarto caractere: ", strelem(nome, 3);
  imprima "\ntodos menos o primeiro: ", strresto(nome);
  imprima "\nos dois ultimos: ", strnresto(nome, corte);
  imprima "\n";
fimprog
