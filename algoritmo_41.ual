# Algoritmo 41
# Ler quatro números e imprimir a média ponderada (pesos 1, 2, 3 e 4).

prog alg41
  real n1, n2, n3, n4, mediaPond;
  imprima "\nNumero 1 (peso 1): ";
  leia n1;
  imprima "\nNumero 2 (peso 2): ";
  leia n2;
  imprima "\nNumero 3 (peso 3): ";
  leia n3;
  imprima "\nNumero 4 (peso 4): ";
  leia n4;
  # soma dos pesos: 1 + 2 + 3 + 4 = 10
  mediaPond <- (n1 * 1 + n2 * 2 + n3 * 3 + n4 * 4) / 10;
  imprima "\nMedia ponderada: ", mediaPond;
  imprima "\n";
fimprog
